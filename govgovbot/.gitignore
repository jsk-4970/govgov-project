# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/

# Environment variables (CRITICAL - NEVER COMMIT)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data files
data/*.csv
data/*.json
data/*.pdf
data/*.xlsx
!data/.gitkeep

# Logs
*.log
logs/

