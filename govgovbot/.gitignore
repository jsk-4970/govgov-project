*.json
!config/*.example.json
*-key.json
service-account*.json
credentials.json
client_secret*.json
google-credentials*.json
application_default_credentials.json

# GCP specific
.gcloud/
.config/gcloud/

# API Keys and Secrets (CRITICAL)
*_api_key*
*_secret*
*.pem
*.key
*.p12
*.pfx
.secret
secrets/
*.credentials

# Testing
.pytest_cache/
.coverage
htmlcov/

