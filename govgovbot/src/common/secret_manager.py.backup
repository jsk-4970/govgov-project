"""Google Secret Managerからシークレットを取得するモジュール

Secret Managerを使用して安全に認証情報を管理します。
"""

import logging
from typing import Optional

from google.cloud import secretmanager
from tenacity import retry, stop_after_attempt, wait_exponential

logger = logging.getLogger(__name__)


class SecretManagerClient:
    """Secret Managerからシークレットを取得するクライアント"""

    def __init__(self, project_id: str) -> None:
        """クライアントを初期化する

        Args:
            project_id: GCPプロジェクトID
        """
        self.project_id = project_id
        self.client = secretmanager.SecretManagerServiceClient()
        logger.info(f"SecretManagerClient initialized for project: {project_id}")

    @retry(
        stop=stop_after_attempt(3),
        wait=wait_exponential(multiplier=1, min=2, max=10),
    )
    def get_secret(self, secret_id: str, version: str = "latest") -> str:
        """Secret Managerからシークレットを取得する

        Args:
            secret_id: シークレットID
            version: シークレットのバージョン（デフォルト: "latest"）

        Returns:
            シークレットの値

        Raises:
            Exception: シークレット取得に失敗した場合
        """
        name = f"projects/{self.project_id}/secrets/{secret_id}/versions/{version}"

        try:
            logger.info(f"Fetching secret: {secret_id}")
            response = self.client.access_secret_version(request={"name": name})
            secret_value = response.payload.data.decode("UTF-8")
            logger.info(f"Successfully fetched secret: {secret_id}")
            return secret_value
        except Exception as e:
            logger.error(f"Failed to fetch secret {secret_id}: {str(e)}")
            raise


def get_secret(project_id: str, secret_id: str, version: str = "latest") -> str:
    """Secret Managerからシークレットを取得する便利関数

    Args:
        project_id: GCPプロジェクトID
        secret_id: シークレットID
        version: シークレットのバージョン（デフォルト: "latest"）

    Returns:
        シークレットの値

    Raises:
        Exception: シークレット取得に失敗した場合
    """
    client = SecretManagerClient(project_id)
    return client.get_secret(secret_id, version)
